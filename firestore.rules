rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // دوال مساعدة
    // ─────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    // الإيميل لازم يكون مؤكَّد — وإلا أي شخص يسجّل بإيميل الأدمن يصير أدمن
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'hosam2564491@gmail.com',
          'info@3engs.com'
        ];
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function shortStr(v, max) {
      return v is string && v.size() <= max;
    }

    // ─────────────────────────────────────────
    // المحتوى العام — قراءة للجميع
    // ⚠️ fileUrl هنا يكون فقط للعناصر المجانية
    // ─────────────────────────────────────────
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /courses/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /books/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /custom_sections/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /section_items/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────
    // 🔒 روابط ملفات العناصر المدفوعة — {col}__{id}
    // الأدمن فقط. السيرفر يقرأها ويعطيها للمشتري بعد الدفع.
    // ─────────────────────────────────────────
    match /private_files/{doc} {
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────
    // رسائل التواصل
    // ─────────────────────────────────────────
    match /contact_messages/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','subject','message','timestamp']) &&
        shortStr(request.resource.data.name, 100) &&
        shortStr(request.resource.data.email, 200) &&
        shortStr(request.resource.data.message, 5000) &&
        (!('subject' in request.resource.data) || shortStr(request.resource.data.subject, 200));
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // النشرة البريدية
    // ─────────────────────────────────────────
    match /newsletter_subscribers/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['email','timestamp']) &&
        shortStr(request.resource.data.email, 200);
      allow read, delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // المستخدمون
    // ─────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // المستخدم ينشئ ملفه بدور "user" فقط
      allow create: if isOwner(userId) &&
        (request.resource.data.get('role', 'user') == 'user' || isAdmin());
      // المستخدم يعدّل ملفه فقط — لكن لا يغير role أبداً
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['role', 'uid', 'userId', 'createdAt']));
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // 🔒 الطلبات — الكتابة فقط من Cloud Functions (Admin SDK)
    // ─────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ─────────────────────────────────────────
    // رفض أي شيء آخر
    // ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
