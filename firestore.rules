rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────
    // دوال مساعدة
    // ─────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    // الإيميل لازم يكون مؤكَّد — وإلا أي شخص يسجّل بإيميل الأدمن يصير أدمن
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'hosam2564491@gmail.com',
          'info@3engs.com'
        ];
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function shortStr(v, max) {
      return v is string && v.size() <= max;
    }

    // ─────────────────────────────────────────
    // المحتوى العام — قراءة للجميع
    // ⚠️ fileUrl هنا يكون فقط للعناصر المجانية
    // ─────────────────────────────────────────
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /courses/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /books/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /custom_sections/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /section_items/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────
    // 🔒 روابط ملفات العناصر المدفوعة — {col}__{id}
    // الأدمن فقط. السيرفر يقرأها ويعطيها للمشتري بعد الدفع.
    // ─────────────────────────────────────────
    match /private_files/{doc} {
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────
    // رسائل التواصل
    // ─────────────────────────────────────────
    match /contact_messages/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','subject','message','timestamp']) &&
        shortStr(request.resource.data.name, 100) &&
        shortStr(request.resource.data.email, 200) &&
        shortStr(request.resource.data.message, 5000) &&
        (!('subject' in request.resource.data) || shortStr(request.resource.data.subject, 200));
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // النشرة البريدية
    // ─────────────────────────────────────────
    match /newsletter_subscribers/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['email','timestamp']) &&
        shortStr(request.resource.data.email, 200);
      allow read, delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // المستخدمون
    // ─────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // المستخدم ينشئ ملفه بدور "user" فقط
      allow create: if isOwner(userId) &&
        (request.resource.data.get('role', 'user') == 'user' || isAdmin());
      // المستخدم يعدّل ملفه فقط — لكن لا يغير role أبداً
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['role', 'uid', 'userId', 'createdAt']));
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // 🔒 الطلبات — الكتابة فقط من Cloud Functions (Admin SDK)
    // ─────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ─────────────────────────────────────────
    // 🎟️ الورشات والتسجيل فيها
    // معرّف التسجيل = {workshopId}__{phone} ← نفس الرقم ما بيتسجل مرتين
    // ─────────────────────────────────────────
    match /workshops/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /workshop_registrations/{regId} {
      allow create: if request.resource.data.keys().hasOnly(['workshopId','workshopTitle','name','phone','email','uid','country','major','timestamp']) &&
        request.resource.data.keys().hasAll(['workshopId','name','phone','email','uid','country','major','timestamp']) &&
        shortStr(request.resource.data.workshopId, 100) &&
        shortStr(request.resource.data.name, 100) && request.resource.data.name.size() >= 2 &&
        request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{9,15}$') &&
        regId == request.resource.data.workshopId + '__' + request.resource.data.phone &&
        shortStr(request.resource.data.email, 200) &&
        (!('workshopTitle' in request.resource.data) || shortStr(request.resource.data.workshopTitle, 200)) &&
        shortStr(request.resource.data.country, 60) && request.resource.data.country.size() >= 1 &&
        shortStr(request.resource.data.major, 100) && request.resource.data.major.size() >= 1 &&
        (request.resource.data.uid == '' || (isSignedIn() && request.resource.data.uid == request.auth.uid)) &&
        request.resource.data.timestamp == request.time &&
        get(/databases/$(database)/documents/workshops/$(request.resource.data.workshopId)).data.open == true;
      allow read, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────
    // 🧮 الأدوات المتقدمة — الصلاحية من السيرفر، والحفظ لصاحب الصلاحية فقط
    // ─────────────────────────────────────────
    function toolsPro(uid) {
      return exists(/databases/$(database)/documents/entitlements/$(uid)) &&
        get(/databases/$(database)/documents/entitlements/$(uid)).data.get("toolsPro", false) == true;
    }
    match /entitlements/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
    // 3ENG CAD: الدوائر ولوحات التجارب المحفوظة — لصاحب الصلاحية فقط
    match /cad_saves/{uid}/items/{doc} {
      allow read, delete: if isOwner(uid) && toolsPro(uid);
      allow create: if isOwner(uid) && toolsPro(uid) &&
        request.resource.data.keys().hasOnly(["kind","title","data","createdAt"]) &&
        request.resource.data.kind in ["schematic","breadboard"] &&
        shortStr(request.resource.data.title, 120) &&
        request.resource.data.data is string && request.resource.data.data.size() <= 900000 &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
    }
    match /tool_saves/{uid}/items/{doc} {
      allow read, delete: if isOwner(uid) && toolsPro(uid);
      allow create: if isOwner(uid) && toolsPro(uid) &&
        request.resource.data.keys().hasOnly(["tool","title","inputs","results","createdAt"]) &&
        shortStr(request.resource.data.tool, 60) &&
        shortStr(request.resource.data.title, 120) &&
        request.resource.data.inputs is list && request.resource.data.inputs.size() <= 200 &&
        request.resource.data.results is list && request.resource.data.results.size() <= 40 &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // ─────────────────────────────────────────
    // رفض أي شيء آخر
    // ─────────────────────────────────────────
    // عدّاد الزوار (assets/visit.js): أي أحد يزيد 1 فقط، والقراءة للأدمن
    match /site_stats/{id} {
      allow read: if isAdmin();
      allow create: if (id == 'total' || id.matches('d_[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
