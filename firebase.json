{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "src/**",
      "*.md",
      "*.mjs",
      "*.rules",
      "index-additions.html",
      "CNAME"
    ],
    "trailingSlash": true,
    "headers": [
      { "source": "**/*.@(js|css|webp|jpg|png|svg|woff2)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
